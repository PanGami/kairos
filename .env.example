# Salin ke .env lalu isi. JANGAN commit .env.
# ---- PostgreSQL ----
POSTGRES_USER=kairos
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=kairos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- ml-service (gRPC) ----
ML_SERVICE_HOST=ml-service
ML_SERVICE_PORT=50051

# ---- gateway (REST) ----
GATEWAY_PORT=8080
# API key untuk endpoint admin (POST /v1/admin/refresh). Bukan untuk user publik.
ADMIN_API_KEY=change_me_admin_key
# Rate limit per IP (request per menit)
RATE_LIMIT_PER_MIN=120

# ---- Ingestion ----
# Dibuang candle bertanggal hari berjalan; as_of_date = D-1
TZ=Asia/Jakarta
