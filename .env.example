# Copy to .env and fill in values. DO NOT commit .env.
COMPOSE_FILE=docker-compose.local.yml

# ---- PostgreSQL ----
POSTGRES_USER=kairos
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=kairos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- ml-service (gRPC) ----
ML_SERVICE_HOST=ml-service
ML_SERVICE_PORT=50051

# ---- gateway (REST) ----
GATEWAY_PORT=8080
# API key for admin endpoint (POST /v1/admin/refresh). Not for public users.
ADMIN_API_KEY=change_me_admin_key
# Rate limit per IP (requests per minute)
RATE_LIMIT_PER_MIN=120

# ---- Ingestion ----
# Drop current-day candles; as_of_date = D-1
TZ=Asia/Jakarta
