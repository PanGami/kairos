# Copy to .env and fill in values. DO NOT commit .env.
COMPOSE_FILE=docker-compose.local.yml

# ---- PostgreSQL ----
POSTGRES_USER=kairos
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=kairos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- ml-service (gRPC) ----
ML_SERVICE_HOST=ml-service
ML_SERVICE_PORT=50051

# ---- auth-service (gRPC + Google OAuth + Google SMTP) ----
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=50052
GOOGLE_CLIENT_ID=
# Enable dev sandbox sign-in locally when GOOGLE_CLIENT_ID is empty (always false in production).
AUTH_DEV_BYPASS=true
# Google SMTP mailer settings (leave SMTP_USER/SMTP_PASSWORD empty locally to log OTP to stdout).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kairos <noreply@kairos>
# Comma-separated emails automatically promoted to admin role on startup, registration, and login.
ADMIN_EMAILS=
# Set true when serving strictly over HTTPS (always true in production).
AUTH_COOKIE_SECURE=false

# ---- gateway (REST) ----
GATEWAY_PORT=8080
# API key for admin endpoint (POST /v1/admin/refresh). Not for public users.
ADMIN_API_KEY=change_me_admin_key
# Rate limit per IP (requests per minute)
RATE_LIMIT_PER_MIN=120
# Cloudflare Turnstile CAPTCHA (leave empty locally to disable CAPTCHA enforcement)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Ingestion ----
# Drop current-day candles; as_of_date = D-1
TZ=Asia/Jakarta
